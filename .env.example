# Application
ASSISTANT_NAME=Gouri
LOG_LEVEL=INFO
MAX_CONTEXT_MESSAGES=10

# Local music directory. Use a Windows path if running on Windows.
MUSIC_DIRECTORY=

# LLM is optional. The application works without it.
LLM_ENABLED=false
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=

# Speech recognition
SPEECH_LANGUAGE=en-US
LISTEN_TIMEOUT=5
PHRASE_TIME_LIMIT=8
